/* Charlotte & Ciaran — 3 July 2027 — Castell de Tamarit */
/* Palette matched to the Canva Save the Date */
:root {
  --ink: #1c1c1c;
  --ink-soft: #5c5450;
  --cream: #fff6e2;
  --cream-soft: #faf7ef;
  --burgundy: #501e1f;
  --burgundy-soft: #6f2222;
  --line: rgba(80,30,31,.18);
  --accent: #501e1f;
  --serif: 'Cormorant Garamond', Georgia, serif;
  --script: 'Italianno', 'Cormorant Garamond', cursive;
  --sans: 'Jost', 'Segoe UI', sans-serif;
  /* legacy aliases so older markup keeps working */
  --sand: var(--cream);
  --sand-deep: #eadfc9;
  --sea: var(--burgundy);
  --sea-deep: var(--burgundy);
  --white: var(--cream-soft);
}
* { margin: 0; padding: 0; box-sizing: border-box; }
.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
html { scroll-behavior: smooth; }
body { font-family: var(--sans); font-weight: 300; color: var(--ink); background: var(--cream-soft); line-height: 1.75; letter-spacing: .01em; }
img { max-width: 100%; display: block; }
a { color: var(--burgundy); }

/* Header */
.site-header { position: sticky; top: 0; z-index: 50; background-color: var(--burgundy); background-image: linear-gradient(rgba(89,20,20,.92), rgba(89,20,20,.92)), url('images/wallpaper.jpg'); background-size: cover; background-position: center 42%; border-bottom: 1px solid rgba(255,246,226,.14); }
.nav { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; padding: 1.15rem 1.5rem; max-width: 1080px; margin: 0 auto; }
.nav-links { display: flex; gap: 1.6rem; flex-wrap: wrap; }
.nav-left { justify-content: flex-end; }
.nav-right { justify-content: flex-start; }
.nav-links a { text-decoration: none; font-size: .66rem; letter-spacing: .26em; text-transform: uppercase; color: rgba(255,246,226,.78); padding: .2rem 0; border-bottom: 1px solid transparent; transition: color .2s ease, border-color .2s ease; }
.nav-links a:hover { color: var(--cream); border-color: var(--cream); }
.brand { text-align: center; text-decoration: none; }
.monogram { font-family: var(--script); font-size: 2.5rem; line-height: .85; color: var(--cream); white-space: nowrap; }
.monogram em { font-style: normal; font-size: .55em; vertical-align: middle; opacity: .8; padding: 0 .06em; }

/* Hero */
.hero { position: relative; min-height: 82vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 4.5rem clamp(70px, 16vw, 140px);
  background-color: var(--burgundy);
  overflow: hidden;
}
.hero::before { /* left botanical border */
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: clamp(58px, 14vw, 118px);
  z-index: 1; pointer-events: none;
  background: url('images/bot-vertical.jpg') repeat-y; background-size: 100% auto; opacity: .38;
}
.hero::after { /* right botanical border */
  content: ''; position: absolute; right: 0; top: 0; bottom: 0; width: clamp(58px, 14vw, 118px);
  z-index: 1; pointer-events: none;
  background: url('images/bot-vertical-r.jpg') repeat-y; background-size: 100% auto; opacity: .38;
}
/* Invitation-style hero: names flanking a tilted strip */
.hero-invite {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: clamp(.4rem, 2vw, 1.6rem);
  position: relative; z-index: 2;
  width: 100%; max-width: 780px; margin: 0 auto 1.8rem;
}
.hero-invite .name {
  font-family: var(--script);
  font-size: clamp(1.9rem, 7vw, 3.4rem);
  line-height: 1;
  color: var(--cream);
}
.hero-invite .name-left { text-align: right; }
.hero-invite .name-right { text-align: left; }
.hero-invite .strip-mid { position: relative; }
.hero-invite .strip-mid img {
  display: block;
  width: clamp(96px, 21vw, 140px);
  height: auto;
  transform: rotate(-7deg);
  box-shadow: 0 16px 38px rgba(0,0,0,.42);
}
/* cupids floating beside the strip, top right */
/* cupids floating beside the strip, top right */
.hero-invite .cupids {
  position: absolute; top: -22%; right: -58%;
  width: clamp(64px, 15vw, 104px);
  opacity: .92; pointer-events: none;
  mix-blend-mode: screen;
}
.hero-invite .cupids img { width: 100%; height: auto; display: block; }
/* floral borders running down both sides of the hero */
.hero > * { position: relative; z-index: 2; }


/* botanical garland along the foot of the hero (artwork from the save-the-date) */
.hero-botanicals {
  position: absolute; left: 0; right: 0; bottom: 0; height: 210px; z-index: 1;
  background: url('images/bot-bottom.jpg') center bottom / cover no-repeat;
  -webkit-mask-image: linear-gradient(to top, #000 0%, #000 32%, rgba(0,0,0,.35) 72%, transparent 100%);
  mask-image: linear-gradient(to top, #000 0%, #000 32%, rgba(0,0,0,.35) 72%, transparent 100%);
  opacity: .55;
  pointer-events: none;
}

/* cherub line art, blended onto the burgundy */
.hero-cherubs { position: absolute; top: 2.2rem; left: 50%; transform: translateX(-50%); width: min(240px, 46vw); opacity: .28; mix-blend-mode: screen; pointer-events: none; z-index: 1; }
.hero-cherubs img { width: 100%; height: auto; }
.hero-kicker { text-transform: uppercase; letter-spacing: .42em; font-size: .68rem; font-weight: 400; color: rgba(255,246,226,.75); margin-bottom: 1.6rem; }
.hero h1 { font-family: var(--script); font-weight: 400; font-size: clamp(3.6rem, 13vw, 8rem); line-height: .95; color: var(--cream); }
.hero h1 .amp { font-style: normal; color: var(--cream); opacity: .75; padding: 0 .1em; }
.hero-date { font-family: var(--sans); text-transform: uppercase; letter-spacing: .18em; font-size: clamp(.56rem, 1.5vw, .72rem); color: var(--cream); margin: 1.8rem 1rem 2.4rem; max-width: 30rem; line-height: 1.9; }

/* Countdown */
.countdown { display: flex; gap: .55rem; justify-content: center; margin-bottom: 2.6rem; }
.cd-box { background: transparent; border: 1px solid rgba(255,246,226,.3); border-radius: 0; padding: .7rem 1rem; min-width: 68px; }
.cd-num { font-family: var(--serif); font-weight: 400; font-size: 1.7rem; line-height: 1.1; color: var(--cream); }
.cd-label { font-size: .58rem; text-transform: uppercase; letter-spacing: .22em; color: rgba(255,246,226,.65); margin-top: .2rem; }

/* Buttons */
.btn { display: inline-block; font-family: var(--sans); font-weight: 400; text-transform: uppercase; letter-spacing: .26em; font-size: .7rem; text-decoration: none; padding: 1rem 2.2rem; border-radius: 0; background: var(--cream); color: var(--burgundy); border: 1px solid var(--cream); cursor: pointer; transition: background .2s ease, color .2s ease; }
.btn:hover { background: transparent; color: var(--cream); border-color: var(--cream); }
.btn.ghost { background: transparent; color: var(--burgundy); border: 1px solid var(--burgundy); }
.btn.ghost:hover { background: var(--burgundy); color: var(--cream); }
/* on the burgundy hero the ghost button needs cream ink */
.hero .btn.ghost { color: var(--cream); border-color: rgba(255,246,226,.55); }
.hero .btn.ghost:hover { background: var(--cream); color: var(--burgundy); border-color: var(--cream); }

/* Sections */
.section { max-width: 880px; margin: 0 auto; padding: 5rem 1.25rem; }
.section h2 { font-family: var(--script); font-weight: 400; font-size: clamp(2.8rem, 7vw, 4rem); line-height: 1; color: var(--burgundy); text-align: center; }
.section .lede { text-align: center; font-family: var(--sans); font-weight: 300; font-style: normal; font-size: .95rem; color: var(--ink-soft); max-width: 34rem; margin: 1.2rem auto 3rem; }
.section .lede::after { content: ''; display: block; width: 46px; height: 1px; background: var(--line); margin: 1.6rem auto 0; }

/* Vintage wallpaper (Where to Stay) */
.section-wallpaper { position: relative; max-width: none; overflow: hidden; }
.section-wallpaper::before {
  content: ''; position: absolute; inset: 0; z-index: 0;
  background-image: url('images/wallpaper.jpg');
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  opacity: .9;
  pointer-events: none;
}
.section-wallpaper > * { position: relative; z-index: 1; }
.section-wallpaper h2, .section-wallpaper .lede { color: #4a3a1e; }
.section-wallpaper .card { background: rgba(253, 248, 236, .93); }

/* Cards */
.cards { display: grid; gap: 1.6rem; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
.card { background: var(--cream); border: 1px solid var(--line); border-radius: 0; padding: 2rem 1.75rem; }
.card h3 { font-family: var(--serif); font-weight: 500; font-size: 1.45rem; color: var(--burgundy); margin-bottom: .6rem; }
.card p { color: var(--ink-soft); font-size: .92rem; line-height: 1.8; }
.tag { display: inline-block; font-size: .6rem; text-transform: uppercase; letter-spacing: .24em; background: transparent; color: var(--burgundy); border: 1px solid var(--line); border-radius: 0; padding: .3rem .7rem; margin: 0 .35rem .8rem 0; }

/* Timeline */
.timeline { max-width: 620px; margin: 0 auto; position: relative; padding-left: 1.75rem; }
.timeline::before { content: ''; position: absolute; left: 4px; top: 6px; bottom: 6px; width: 1px; background: var(--line); }
.event { position: relative; padding: 0 0 2.6rem 1.5rem; }
.event::before { content: ''; position: absolute; left: -1.75rem; top: .55rem; width: 9px; height: 9px; border-radius: 50%; background: var(--burgundy); box-shadow: 0 0 0 5px var(--cream-soft); }
.event .when { text-transform: uppercase; letter-spacing: .24em; font-size: .65rem; color: var(--burgundy); }
.event h3 { font-family: var(--serif); font-weight: 500; font-size: 1.45rem; color: var(--burgundy); margin: .35rem 0 .4rem; }

/* Forms */
.form-grid { display: grid; gap: 1.3rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); max-width: 640px; margin: 0 auto; }
.field label { display: block; font-size: .62rem; text-transform: uppercase; letter-spacing: .24em; color: var(--ink-soft); margin-bottom: .45rem; }
.field input, .field select, .field textarea { width: 100%; padding: .8rem .9rem; border: 1px solid var(--line); border-radius: 0; background: var(--cream); font-family: var(--sans); font-weight: 300; font-size: 1rem; color: var(--ink); }
.field input:focus, .field select:focus, .field textarea:focus { outline: none; border-color: var(--burgundy); }
.notice { background: var(--cream); border: 1px solid var(--line); border-left: 2px solid var(--burgundy); border-radius: 0; padding: 1rem 1.2rem; text-align: center; color: var(--ink-soft); font-size: .88rem; max-width: 640px; margin: 2rem auto 0; }

/* FAQ */
.faq-item { border-bottom: 1px solid var(--line); padding: 1.6rem 0; }
.faq-item:first-of-type { border-top: 1px solid var(--line); }
.faq-item h3 { font-family: var(--serif); font-weight: 500; font-size: 1.25rem; color: var(--burgundy); margin-bottom: .5rem; }
.faq-item p { color: var(--ink-soft); font-size: .93rem; }

/* Footer */
.site-footer { background: var(--burgundy); color: var(--cream); text-align: center; padding: 3.5rem 1.25rem; margin-top: 2rem; }
.site-footer .names { font-family: var(--script); font-size: 2.6rem; line-height: 1; letter-spacing: .02em; }
.site-footer p { font-size: .68rem; text-transform: uppercase; letter-spacing: .24em; opacity: .7; margin-top: 1rem; }

/* Photo strip on burgundy */
.strip-band { background: var(--burgundy); padding: 3rem 1.25rem; text-align: center; }
.strip { display: flex; justify-content: center; margin: 0 auto; }
.strip img { width: min(200px, 52vw); height: auto; border: 0; box-shadow: 0 18px 45px rgba(0,0,0,.34); }
.strip-caption { text-align: center; font-size: .62rem; text-transform: uppercase; letter-spacing: .24em; color: var(--ink-soft); margin-top: 1.4rem; }

@media (max-width: 720px) {
  .nav { grid-template-columns: 1fr; gap: .5rem; padding: .9rem 1rem; justify-items: center; }
  .nav-left, .nav-right { justify-content: center; }
  .nav-links { gap: 1.1rem; }
  .nav-links a { font-size: .6rem; letter-spacing: .2em; }
  .monogram { font-size: 2.1rem; }
}

@media (max-width: 560px) {
  .countdown { flex-wrap: wrap; }
}
